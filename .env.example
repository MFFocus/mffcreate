# MffConvert Root Environment Configuration Template
#
# Production Backend URL for Netlify:
# NEXT_PUBLIC_BACKEND_URL=https://mffconvert-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=

# Backend Hosting Configuration:
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://mffconvert.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1
