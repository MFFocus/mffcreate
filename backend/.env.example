# MffConvert Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENV=production

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://mffconvert.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# Maximum number of concurrent video analysis jobs (default: 2)
MAX_CONCURRENT_JOBS=2

# Persistent data directory (useful when mounting volumes in Docker/Render/Railway)
DATA_DIR=/app/data

# Optional: Local or remote Ollama LLM endpoint
OLLAMA_URL=http://localhost:11434
