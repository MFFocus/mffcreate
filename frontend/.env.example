# MffConvert Frontend Environment Variables
#
# Local Development (leave blank or set to http://127.0.0.1:8000):
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
#
# Production Deployment on Netlify:
# Set this to the public URL of your deployed Python FastAPI backend
# (e.g. on Render, Railway, Fly.io, or VPS)
# Example: NEXT_PUBLIC_BACKEND_URL=https://mffconvert-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=

# Disable Next.js anonymous telemetry collection
NEXT_TELEMETRY_DISABLED=1
