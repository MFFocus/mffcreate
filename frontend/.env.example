# MffConvert Frontend Environment Variables
# For Netlify / Cloud Production:
# Leave NEXT_PUBLIC_BACKEND_URL blank to use the built-in serverless App Router processing engine.
# If connecting to an external custom backend API, provide its public URL (e.g., https://api.mffconvert.com)
NEXT_PUBLIC_BACKEND_URL=

# Disable Next.js anonymous telemetry collection
NEXT_TELEMETRY_DISABLED=1
